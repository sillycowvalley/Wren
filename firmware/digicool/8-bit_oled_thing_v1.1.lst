    8C93  .db $8C, $A0, $62, $00, $00, $8C, $CA, $62, $00, $34, $8C, $CB, $00

; the start-up copy's source: RAM $00-$2A at start (pin descriptors, then variables)
    8CA0  .db $50, $05, $50, $0F, $50, $0F, $50, $0F, $50, $0A, $50, $0A, $50, $0A, $50, $0A
