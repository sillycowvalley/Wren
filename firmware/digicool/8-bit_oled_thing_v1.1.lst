; constants never used
    8080  .db $00, $03, $0D, $40, $00, $78, $10, $20, $10, $20, $40, $08, $10, $20, $40, $80
    8090  .db $02, $04, $08, $04, $08

; bit cell, 0 (outline), bits-only view: 7 x 32 in OLED RAM order
