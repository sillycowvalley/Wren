    8044  82 00 9E 7D    int    unused_irq              ; IRQ 15
    8048  82 00 9E 7D    int    unused_irq              ; IRQ 16
    804C  82 00 9E 7D    int    unused_irq              ; IRQ 17
    8050  82 00 9E 7D    int    unused_irq              ; IRQ 18
    8054  82 00 9E 7D    int    unused_irq              ; IRQ 19
    8058  82 00 9E 7D    int    unused_irq              ; IRQ 20
    805C  82 00 9E 7D    int    unused_irq              ; IRQ 21
    8060  82 00 9E 7D    int    unused_irq              ; IRQ 22
    8064  82 00 9E 7D    int    unused_irq              ; IRQ 23
    8068  82 00 9E 7D    int    unused_irq              ; IRQ 24
