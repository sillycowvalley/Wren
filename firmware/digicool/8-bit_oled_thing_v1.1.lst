; Cosmic's C start-up: stack at $03FF, copy the initialised data from $8CA0 to
; RAM, clear the rest, call main.
reset:
    8CCB  AE 03 FF       ldw    X,#RAM_END                 
    8CCE  94             ldw    SP,X                       
    8CCF  90 CE 8C 93    ldw    Y,$8C93                    
    8CD3  AE 8C 95       ldw    X,#$8C95                   
