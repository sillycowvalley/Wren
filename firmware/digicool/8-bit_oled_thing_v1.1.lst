    8E0A  A6 80          ld     A,#$80                     
    8E0C  CD 9A FD       call   CLK_SYSCLKConfig           
    8E0F  AE 50 00       ldw    X,#PA_ODR                  
    8E12  CD 98 9A       call   GPIO_DeInit                
    8E15  AE 50 05       ldw    X,#PB_ODR                  
    8E18  CD 98 9A       call   GPIO_DeInit                
    8E1B  AE 50 0A       ldw    X,#PC_ODR                  
    8E1E  CD 98 9A       call   GPIO_DeInit                
    8E21  AE 50 0F       ldw    X,#PD_ODR                  
    8E24  CD 98 9A       call   GPIO_DeInit                
    8E27  CD 8F AB       call   oled_init                  
    8E2A  CD 93 8D       call   setup_b_inputs             
    8E2D  CD 93 F3       call   setup_pd3                  
    8E30  AE 03 02       ldw    X,#$302                    
    8E33  CD 8D 24       call   sub_8D24                   
    8E36  9A             rim                               ; interrupts on: only port D (PD3) can interrupt
    8E37  CD 94 26       call   read_b                     

; One pass about every 37 us: read the mode pins (RAM $21; HEX PA1, BAR PA2,
; INV PA3), read b0-b7 unless held or latched, redraw what changed. No debounce.
main_loop:
    8E3A  CD 94 87       call   read_mode                  
    8E3D  B6 21          ld     A,$21                      
    8E3F  B1 22          cp     A,$22                      
    8E41  72 06 00 34 03 btjt   $34,#3,dice                
    8E46  CC 8E F3       jp     normal_views               

; Dice Roll (HEX and BAR both low): entering it shows a 6; any b input low rolls,
; faces every ~115 ms while held, then slowing down: 4 faces ~117 ms apart, 3 ~226 ms
; apart, a blank, the final face ~1.53 s after release. Never the same face twice.
dice:
    8E49  27 28          jreq   L_8E73                     
    8E4B  CD 93 8D       call   setup_b_inputs             
    8E4E  5F             clrw   X                          
    8E4F  BF 1E          ldw    $1E,X                      
    8E51  3F 29          clr    $29                        
    8E53  72 01 00 34 05 btjf   $34,#0,L_8E5D              
    8E58  AE A7 00       ldw    X,#$A700                   
    8E5B  20 03          jra    L_8E60                     
L_8E5D:
    8E5D  AE A6 00       ldw    X,#$A600                   
L_8E60:
    8E60  CD 90 2B       call   oled_command               
    8E63  4F             clr    A                          
    8E64  CD 90 74       call   sub_9074                   
    8E67  72 1D 00 34    bres   $34,#6                     
    8E6B  A6 05          ld     A,#$5                      
    8E6D  CD 92 F5       call   draw_face                  
    8E70  45 21 22       mov    $22,$21                    
L_8E73:
    8E73  72 0D 00 34 68 btjf   $34,#6,dice_idle           
    8E78  BE 1E          ldw    X,$1E                      
    8E7A  B6 29          ld     A,$29                      
    8E7C  44             srl    A                          
    8E7D  44             srl    A                          
    8E7E  A0 04          sub    A,#$4                      
    8E80  40             neg    A                          
    8E81  27 04          jreq   L_8E87                     
L_8E83:
    8E83  58             slaw   X                          
    8E84  4A             dec    A                          
    8E85  26 FC          jrne   L_8E83                     
L_8E87:
    8E87  A3 00 00       cpw    X,#$0                      
    8E8A  27 03          jreq   L_8E8F                     
    8E8C  CC 8F 32       jp     random_step                
L_8E8F:
    8E8F  B6 29          ld     A,$29                      
    8E91  A1 0A          cp     A,#$A                      
    8E93  24 45          jruge  L_8EDA                     
    8E95  CD 94 26       call   read_b                     
    8E98  B6 23          ld     A,$23                      
    8E9A  4C             inc    A                          
    8E9B  26 04          jrne   L_8EA1                     
    8E9D  3C 29          inc    $29                        
    8E9F  20 02          jra    L_8EA3                     
L_8EA1:
    8EA1  3F 29          clr    $29                        
L_8EA3:
    8EA3  B6 29          ld     A,$29                      
    8EA5  A1 08          cp     A,#$8                      
    8EA7  24 20          jruge  L_8EC9                     
    8EA9  45 27 28       mov    $28,$27                    
    8EAC  20 13          jra    L_8EC1                     
L_8EAE:
    8EAE  CD 8D D9       call   random_init                
    8EB1  B6 26          ld     A,$26                      
    8EB3  4E             swap   A                          
    8EB4  A4 0E          and    A,#$E                      
    8EB6  44             srl    A                          
    8EB7  B7 27          ld     $27,A                      
    8EB9  A1 06          cp     A,#$6                      
    8EBB  27 F1          jreq   L_8EAE                     
    8EBD  A1 07          cp     A,#$7                      
    8EBF  27 ED          jreq   L_8EAE                     
L_8EC1:
    8EC1  B6 28          ld     A,$28                      
    8EC3  B1 27          cp     A,$27                      
    8EC5  27 E7          jreq   L_8EAE                     
    8EC7  B6 29          ld     A,$29                      
L_8EC9:
    8EC9  A1 08          cp     A,#$8                      
    8ECB  26 06          jrne   L_8ED3                     
    8ECD  4F             clr    A                          
    8ECE  CD 90 74       call   sub_9074                   
    8ED1  20 5F          jra    random_step                
L_8ED3:
    8ED3  B6 27          ld     A,$27                      
    8ED5  CD 92 F5       call   draw_face                  
    8ED8  20 58          jra    random_step                
L_8EDA:
    8EDA  72 1D 00 34    bres   $34,#6                     
    8EDE  20 52          jra    random_step                

; While not rolling: b0-b7 read (with pull-ups); any input low starts a roll.
dice_idle:
    8EE0  CD 94 26       call   read_b                     
    8EE3  B6 23          ld     A,$23                      
    8EE5  4C             inc    A                          
    8EE6  27 4A          jreq   random_step                
    8EE8  72 1C 00 34    bset   $34,#6                     
    8EEC  5F             clrw   X                          
    8EED  BF 1E          ldw    $1E,X                      
    8EEF  3F 29          clr    $29                        
    8EF1  20 3F          jra    random_step                

; A mode change: b0-b7 pull-ups off, inverse on or off (A6/A7), clear, then the
; view drawn. Otherwise b0-b7 read (if live) and redrawn when they changed.
normal_views:
    8EF3  27 1A          jreq   L_8F0F                     
    8EF5  CD 93 8D       call   setup_b_inputs             
    8EF8  5F             clrw   X                          
    8EF9  BF 1E          ldw    $1E,X                      
    8EFB  72 01 00 34 05 btjf   $34,#0,L_8F05              
    8F00  AE A7 00       ldw    X,#$A700                   
    8F03  20 03          jra    L_8F08                     
L_8F05:
    8F05  AE A6 00       ldw    X,#$A600                   
L_8F08:
    8F08  CD 90 2B       call   oled_command               
    8F0B  4F             clr    A                          
    8F0C  CD 90 74       call   sub_9074                   
L_8F0F:
    8F0F  72 09 00 34 03 btjf   $34,#4,L_8F17              
    8F14  CD 94 26       call   read_b                     
L_8F17:
    8F17  B6 23          ld     A,$23                      
    8F19  B1 24          cp     A,$24                      
    8F1B  26 06          jrne   L_8F23                     
    8F1D  B6 21          ld     A,$21                      
    8F1F  B1 22          cp     A,$22                      
    8F21  27 0F          jreq   random_step                
L_8F23:
    8F23  B6 21          ld     A,$21                      
    8F25  B1 22          cp     A,$22                      
    8F27  27 03          jreq   L_8F2C                     
    8F29  45 21 22       mov    $22,$21                    
L_8F2C:
    8F2C  CD 95 08       call   redraw                     
    8F2F  45 23 24       mov    $24,$23                    

; xorshift16 (x ^= x<<13; x ^= x>>9; x ^= x<<7), once per pass in every mode.
random_step:
    8F32  CD 8D D9       call   random_init                
    8F35  BE 1E          ldw    X,$1E                      
    8F37  5C             incw   X                          
    8F38  BF 1E          ldw    $1E,X                      
    8F3A  CC 8E 3A       jp     main_loop                  

; PD3 falling edge (the only interrupt): b0-b7 latched into RAM $23 and the
; latched flag set. Only a reset clears it; every later edge latches again.
exti_port_d:
    8F3D  8A             push   CC                         
    8F3E  84             pop    A                          
    8F3F  A4 BF          and    A,#$BF                     
    8F41  88             push   A                          
    8F42  86             pop    CC                         
    8F43  3B 00 30       push   $30                        
    8F46  BE 2E          ldw    X,$2E                      
    8F48  89             pushw  X                          
    8F49  3B 00 33       push   $33                        
    8F4C  BE 31          ldw    X,$31                      
    8F4E  89             pushw  X                          
    8F4F  CD 94 26       call   read_b                     
    8F52  72 1A 00 34    bset   $34,#5                     
    8F56  85             popw   X                          
    8F57  BF 31          ldw    $31,X                      
    8F59  32 00 33       pop    $33                        
    8F5C  85             popw   X                          
    8F5D  BF 2E          ldw    $2E,X                      
    8F5F  32 00 30       pop    $30                        
    8F62  80             iret                              

; I2C at about 205 kHz (fast mode, 8 MHz input clock).
i2c_setup:
    8F63  88             push   A                          
    8F64  CD 9B 3A       call   sub_9B3A                   
    8F67  AE 8C 7B       ldw    X,#$8C7B                   
    8F6A  CD 9C DA       call   sub_9CDA                   
    8F6D  B6 2D          ld     A,$2D                      
    8F6F  6B 01          ld     ($1,SP),A                  
    8F71  CD 95 BE       call   sub_95BE                   
    8F74  7B 01          ld     A,($1,SP)                  
    8F76  88             push   A                          
    8F77  4B 00          push   #$0                        
    8F79  4B 01          push   #$1                        
    8F7B  4B 00          push   #$0                        
    8F7D  AE 00 78       ldw    X,#$78                     
    8F80  89             pushw  X                          
    8F81  AE 0D 40       ldw    X,#$D40                    
    8F84  89             pushw  X                          
    8F85  AE 00 03       ldw    X,#$3                      
    8F88  89             pushw  X                          
    8F89  CD 95 E3       call   I2C_Init                   
    8F8C  5B 0A          add    SP,#$A                     
    8F8E  A6 01          ld     A,#$1                      
    8F90  CD 96 FF       call   sub_96FF                   
    8F93  84             pop    A                          
    8F94  81             ret                               

; PB4/PB5 as open-drain fast outputs before the I2C takes them.
gpio_open_drain:
    8F95  4B B0          push   #$B0                       
    8F97  4B 10          push   #$10                       
    8F99  BE 00          ldw    X,$0                       
    8F9B  CD 98 A2       call   GPIO_Init                  
    8F9E  85             popw   X                          
    8F9F  4B B0          push   #$B0                       
    8FA1  4B 20          push   #$20                       
    8FA3  BE 00          ldw    X,$0                       
    8FA5  CD 98 A2       call   GPIO_Init                  
    8FA8  85             popw   X                          
    8FA9  20 B8          jra    i2c_setup                  

; The SSD1315's set-up, one command per I2C transaction: off, mux 64, offset 0,
; start line 0, A1/C8 (remapped for the rotated mounting), COM pins, contrast 255,
; RAM display, normal, clock, precharge, VCOMH, vertical addressing, charge pump on,
; clear, on.
oled_init:
    8FAB  AD E8          callr  gpio_open_drain            
    8FAD  AE AE 00       ldw    X,#$AE00                   
    8FB0  AD 79          callr  oled_command               
    8FB2  AE A8 00       ldw    X,#$A800                   
    8FB5  AD 74          callr  oled_command               
    8FB7  AE 3F 00       ldw    X,#$3F00                   
    8FBA  AD 6F          callr  oled_command               
    8FBC  AE D3 00       ldw    X,#$D300                   
    8FBF  AD 6A          callr  oled_command               
    8FC1  5F             clrw   X                          
    8FC2  AD 67          callr  oled_command               
    8FC4  AE 40 00       ldw    X,#EEPROM                  
    8FC7  AD 62          callr  oled_command               
    8FC9  AE A1 00       ldw    X,#$A100                   
    8FCC  AD 5D          callr  oled_command               
    8FCE  AE C8 00       ldw    X,#$C800                   
    8FD1  AD 58          callr  oled_command               
    8FD3  AE DA 00       ldw    X,#$DA00                   
    8FD6  AD 53          callr  oled_command               
    8FD8  AE 12 00       ldw    X,#$1200                   
    8FDB  AD 4E          callr  oled_command               
    8FDD  AE 81 00       ldw    X,#$8100                   
    8FE0  AD 49          callr  oled_command               
    8FE2  AE FF 00       ldw    X,#$FF00                   
    8FE5  AD 44          callr  oled_command               
    8FE7  AE A4 00       ldw    X,#$A400                   
    8FEA  AD 3F          callr  oled_command               
    8FEC  AE A6 00       ldw    X,#$A600                   
    8FEF  AD 3A          callr  oled_command               
    8FF1  AE D5 00       ldw    X,#$D500                   
    8FF4  AD 35          callr  oled_command               
    8FF6  AE 80 00       ldw    X,#$8000                   
    8FF9  AD 30          callr  oled_command               
    8FFB  AE D9 00       ldw    X,#$D900                   
    8FFE  AD 2B          callr  oled_command               
    9000  AE 25 00       ldw    X,#$2500                   
    9003  AD 26          callr  oled_command               
    9005  AE DB 00       ldw    X,#$DB00                   
    9008  AD 21          callr  oled_command               
    900A  AE 20 00       ldw    X,#$2000                   
    900D  AD 1C          callr  oled_command               
    900F  AE 20 00       ldw    X,#$2000                   
    9012  AD 17          callr  oled_command               
    9014  AE 01 00       ldw    X,#$100                    
    9017  AD 12          callr  oled_command               
    9019  AE 8D 00       ldw    X,#$8D00                   
    901C  AD 0D          callr  oled_command               
    901E  AE 14 00       ldw    X,#$1400                   
    9021  AD 08          callr  oled_command               
    9023  4F             clr    A                          
    9024  AD 4E          callr  sub_9074                   
    9026  AE AF 00       ldw    X,#$AF00                   
    9029  20 00          jra    oled_command               

; START, $78, control byte $00, the command, STOP.
oled_command:
    902B  89             pushw  X                          
L_902C:
    902C  AE 03 02       ldw    X,#$302                    
    902F  CD 98 10       call   sub_9810                   
    9032  4D             tnz    A                          
    9033  26 F7          jrne   L_902C                     
    9035  4C             inc    A                          
    9036  CD 97 19       call   sub_9719                   
L_9039:
    9039  AE 03 01       ldw    X,#$301                    
    903C  CD 97 A0       call   I2C_CheckEvent             
    903F  4D             tnz    A                          
    9040  27 F7          jreq   L_9039                     
    9042  AE 78 00       ldw    X,#$7800                   
    9045  CD 97 8E       call   sub_978E                   
L_9048:
    9048  AE 07 82       ldw    X,#$782                    
    904B  CD 97 A0       call   I2C_CheckEvent             
    904E  4D             tnz    A                          
    904F  27 F7          jreq   L_9048                     
    9051  7B 02          ld     A,($2,SP)                  
    9053  CD 97 9C       call   sub_979C                   
L_9056:
    9056  AE 07 80       ldw    X,#$780                    
    9059  CD 97 A0       call   I2C_CheckEvent             
    905C  4D             tnz    A                          
    905D  27 F7          jreq   L_9056                     
    905F  7B 01          ld     A,($1,SP)                  
    9061  CD 97 9C       call   sub_979C                   
L_9064:
    9064  AE 07 84       ldw    X,#$784                    
    9067  CD 97 A0       call   I2C_CheckEvent             
    906A  4D             tnz    A                          
    906B  27 F7          jreq   L_9064                     
    906D  A6 01          ld     A,#$1                      
    906F  CD 97 26       call   sub_9726                   
    9072  85             popw   X                          
    9073  81             ret                               
sub_9074:
    9074  88             push   A                          
    9075  52 04          sub    SP,#$4                     
    9077  AE 21 00       ldw    X,#$2100                   
    907A  AD AF          callr  oled_command               
    907C  AE 20 00       ldw    X,#$2000                   
    907F  AD AA          callr  oled_command               
    9081  AE 5F 00       ldw    X,#$5F00                   
    9084  AD A5          callr  oled_command               
    9086  AE 22 00       ldw    X,#$2200                   
    9089  AD A0          callr  oled_command               
    908B  AE 04 00       ldw    X,#$400                    
    908E  AD 9B          callr  oled_command               
    9090  AE 07 00       ldw    X,#$700                    
    9093  AD 96          callr  oled_command               
    9095  A6 01          ld     A,#$1                      
    9097  CD 97 19       call   sub_9719                   
L_909A:
    909A  AE 03 01       ldw    X,#$301                    
    909D  CD 97 A0       call   I2C_CheckEvent             
    90A0  4D             tnz    A                          
    90A1  27 F7          jreq   L_909A                     
    90A3  AE 78 00       ldw    X,#$7800                   
    90A6  CD 97 8E       call   sub_978E                   
L_90A9:
    90A9  AE 07 82       ldw    X,#$782                    
    90AC  CD 97 A0       call   I2C_CheckEvent             
    90AF  4D             tnz    A                          
    90B0  27 F7          jreq   L_90A9                     
    90B2  A6 60          ld     A,#$60                     
    90B4  CD 97 9C       call   sub_979C                   
L_90B7:
    90B7  AE 07 80       ldw    X,#$780                    
    90BA  CD 97 A0       call   I2C_CheckEvent             
    90BD  4D             tnz    A                          
    90BE  27 F7          jreq   L_90B7                     
    90C0  5F             clrw   X                          
    90C1  1F 03          ldw    ($3,SP),X                  

; When INV is low the clear complements its last 4 bytes, so the panel's
; rightmost column stays dark in every inverted view.
clear_inverse_quirk:
    90C3  5F             clrw   X                          
    90C4  72 00 00 34 00 btjt   $34,#0,L_90C9              
L_90C9:
    90C9  59             rlcw   X                          
    90CA  1F 01          ldw    ($1,SP),X                  
    90CC  1E 03          ldw    X,($3,SP)                  
    90CE  A3 00 FC       cpw    X,#$FC                     
    90D1  26 05          jrne   L_90D8                     
    90D3  AE 00 01       ldw    X,#$1                      
    90D6  20 01          jra    L_90D9                     
L_90D8:
    90D8  5F             clrw   X                          
L_90D9:
    90D9  01             rrwa   X                          
    90DA  14 02          and    A,($2,SP)                  
    90DC  01             rrwa   X                          
    90DD  14 01          and    A,($1,SP)                  
    90DF  01             rrwa   X                          
    90E0  5D             tnzw   X                          
    90E1  27 02          jreq   L_90E5                     
    90E3  03 05          cpl    ($5,SP)                    
L_90E5:
    90E5  7B 05          ld     A,($5,SP)                  
    90E7  CD 97 9C       call   sub_979C                   
L_90EA:
    90EA  AE 07 84       ldw    X,#$784                    
    90ED  CD 97 A0       call   I2C_CheckEvent             
    90F0  4D             tnz    A                          
    90F1  27 F7          jreq   L_90EA                     
    90F3  1E 03          ldw    X,($3,SP)                  
    90F5  5C             incw   X                          
    90F6  1F 03          ldw    ($3,SP),X                  
    90F8  A3 01 00       cpw    X,#$100                    
    90FB  25 C6          jrult  clear_inverse_quirk        
    90FD  A6 01          ld     A,#$1                      
    90FF  CD 97 26       call   sub_9726                   
    9102  5B 05          add    SP,#$5                     
    9104  81             ret                               
sub_9105:
    9105  89             pushw  X                          
    9106  89             pushw  X                          
    9107  72 03 00 34 04 btjf   $34,#1,L_9110              
    910C  A6 1C          ld     A,#$1C                     
    910E  20 02          jra    L_9112                     
L_9110:
    9110  A6 07          ld     A,#$7                      
L_9112:
    9112  6B 01          ld     ($1,SP),A                  
    9114  7B 03          ld     A,($3,SP)                  
    9116  A4 07          and    A,#$7                      
    9118  A0 07          sub    A,#$7                      
    911A  40             neg    A                          
    911B  48             sla    A                          
    911C  48             sla    A                          
    911D  48             sla    A                          
    911E  6B 03          ld     ($3,SP),A                  
    9120  AE 21 00       ldw    X,#$2100                   
    9123  CD 90 2B       call   oled_command               
    9126  7B 03          ld     A,($3,SP)                  
    9128  AB 20          add    A,#$20                     
    912A  5F             clrw   X                          
    912B  95             ld     XH,A                       
    912C  CD 90 2B       call   oled_command               
    912F  7B 03          ld     A,($3,SP)                  
    9131  AB 26          add    A,#$26                     
    9133  5F             clrw   X                          
    9134  95             ld     XH,A                       
    9135  CD 90 2B       call   oled_command               
    9138  AE 22 00       ldw    X,#$2200                   
    913B  CD 90 2B       call   oled_command               
    913E  72 03 00 34 05 btjf   $34,#1,L_9148              
    9143  AE 04 00       ldw    X,#$400                    
    9146  20 03          jra    L_914B                     
L_9148:
    9148  AE 07 00       ldw    X,#$700                    
L_914B:
    914B  CD 90 2B       call   oled_command               
    914E  AE 07 00       ldw    X,#$700                    
    9151  CD 90 2B       call   oled_command               
    9154  A6 01          ld     A,#$1                      
    9156  CD 97 19       call   sub_9719                   
L_9159:
    9159  AE 03 01       ldw    X,#$301                    
    915C  CD 97 A0       call   I2C_CheckEvent             
    915F  4D             tnz    A                          
    9160  27 F7          jreq   L_9159                     
    9162  AE 78 00       ldw    X,#$7800                   
    9165  CD 97 8E       call   sub_978E                   
L_9168:
    9168  AE 07 82       ldw    X,#$782                    
    916B  CD 97 A0       call   I2C_CheckEvent             
    916E  4D             tnz    A                          
    916F  27 F7          jreq   L_9168                     
    9171  A6 60          ld     A,#$60                     
    9173  CD 97 9C       call   sub_979C                   
L_9176:
    9176  AE 07 80       ldw    X,#$780                    
    9179  CD 97 A0       call   I2C_CheckEvent             
    917C  4D             tnz    A                          
    917D  27 F7          jreq   L_9176                     
    917F  0F 02          clr    ($2,SP)                    
    9181  20 47          jra    L_91CA                     
L_9183:
    9183  7B 04          ld     A,($4,SP)                  
    9185  4A             dec    A                          
    9186  26 1B          jrne   L_91A3                     
