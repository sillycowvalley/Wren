    8403  88             push   A                          
    8404  A5 80          bcp    A,#$80                     
    8406  26 0E          jrne   L_8416                     
    8408  C6 50 C6       ld     A,CLK_CKDIVR               
    840B  A4 E7          and    A,#$E7                     
    840D  C7 50 C6       ld     CLK_CKDIVR,A               
