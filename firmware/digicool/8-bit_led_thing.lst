; A float-based millisecond delay; only the old display routine called it.
delay_ms:
    854F  89             pushw  X                          
    8550  20 0A          jra    $855C                      
    8552  AE 03 E8       ldw    X,#$3E8                    
    8555  AD E1          callr  $8538                      
    8557  1E 01          ldw    X,($1,SP)                  
    8559  5A             decw   X                          
    855A  1F 01          ldw    ($1,SP),X                  
    855C  1E 01          ldw    X,($1,SP)                  
    855E  26 F2          jrne   $8552                      
    8560  85             popw   X                          
    8561  81             ret                               

; xorshift16: x ^= x<<13; x ^= x>>9; x ^= x<<7 on RAM $B3-$B4 (seed $8000).
; Called once per frame in every mode, and again for each rejected die face.
random:
    8562  BE B3          ldw    X,$B3                      
    8564  9F             ld     A,XL                       
    8565  4E             swap   A                          
    8566  48             sla    A                          
    8567  A4 E0          and    A,#$E0                     
    8569  5F             clrw   X                          
    856A  95             ld     XH,A                       
    856B  01             rrwa   X                          
    856C  B8 B4          xor    A,$B4                      
    856E  01             rrwa   X                          
    856F  B8 B3          xor    A,$B3                      
    8571  01             rrwa   X                          
    8572  BF B3          ldw    $B3,X                      
    8574  4F             clr    A                          
    8575  01             rrwa   X                          
    8576  54             srlw   X                          
    8577  01             rrwa   X                          
    8578  B8 B4          xor    A,$B4                      
    857A  01             rrwa   X                          
    857B  B8 B3          xor    A,$B3                      
    857D  01             rrwa   X                          
    857E  BF B3          ldw    $B3,X                      
    8580  4F             clr    A                          
    8581  02             rlwa   X                          
    8582  44             srl    A                          
    8583  56             rrcw   X                          
    8584  01             rrwa   X                          
    8585  B8 B4          xor    A,$B4                      
    8587  01             rrwa   X                          
    8588  B8 B3          xor    A,$B3                      
    858A  01             rrwa   X                          
    858B  BF B3          ldw    $B3,X                      
    858D  81             ret                               

; Clock to 8 MHz (CLK_CKDIVR = $08: HSI/2, CPU/1), ports A-D reset, LEDs off,
; b0-b7 floating inputs, M0-M2 pull-up inputs; then the main loop.
main:
    858E  A6 08          ld     A,#$8                      
    8590  CD 83 A9       call   CLK_HSIPrescalerConfig     
    8593  A6 80          ld     A,#$80                     
    8595  CD 84 03       call   CLK_SYSCLKConfig           
    8598  AE 50 00       ldw    X,#PA_ODR                  
    859B  CD 81 A0       call   GPIO_DeInit                
    859E  AE 50 05       ldw    X,#PB_ODR                  
    85A1  CD 81 A0       call   GPIO_DeInit                
    85A4  AE 50 0A       ldw    X,#PC_ODR                  
    85A7  CD 81 A0       call   GPIO_DeInit                
    85AA  AE 50 0F       ldw    X,#PD_ODR                  
    85AD  CD 81 A0       call   GPIO_DeInit                
    85B0  CD 86 A6       call   leds_off                   
    85B3  CD 86 B2       call   setup_inputs               
    85B6  CD 87 03       call   setup_mode_pins            

; Once per frame (about 2.9 ms): read the mode pins (a change restarts the
; sequence), work out the LED pattern, scan it; then step the random number and tick.
main_loop:
    85B9  CD 87 89       call   read_mode                  
    85BC  B6 42          ld     A,$42                      
    85BE  27 1A          jreq   mode_0                     
    85C0  4A             dec    A                          
    85C1  27 28          jreq   mode_1                     
    85C3  4A             dec    A                          
    85C4  27 36          jreq   mode_2                     
    85C6  4A             dec    A                          
    85C7  27 3F          jreq   mode_3                     
    85C9  4A             dec    A                          
    85CA  27 4C          jreq   mode_4                     
    85CC  4A             dec    A                          
    85CD  27 59          jreq   mode_5                     
    85CF  4A             dec    A                          
    85D0  27 66          jreq   mode_6_dice                
    85D2  CD 8C 91       call   mode_7_display             
    85D5  3F B7          clr    $B7                        
    85D7  CC 86 9B       jp     L_869B                     

; Mode 0 (M2 M1 M0 = 000): the curtain, table RAM $9C, one step per 32 frames.
mode_0:
    85DA  BE 3F          ldw    X,$3F                      
    85DC  54             srlw   X                          
    85DD  54             srlw   X                          
    85DE  54             srlw   X                          
    85DF  54             srlw   X                          
    85E0  54             srlw   X                          
    85E1  9F             ld     A,XL                       
    85E2  A4 07          and    A,#$7                      
    85E4  5F             clrw   X                          
    85E5  97             ld     XL,A                       
    85E6  E6 9C          ld     A,($9C,X)                  
    85E8  CC 86 96       jp     L_8696                     

; Mode 1 (001): two LEDs in and out, table RAM $94.
mode_1:
    85EB  BE 3F          ldw    X,$3F                      
    85ED  54             srlw   X                          
    85EE  54             srlw   X                          
    85EF  54             srlw   X                          
    85F0  54             srlw   X                          
    85F1  54             srlw   X                          
    85F2  9F             ld     A,XL                       
    85F3  A4 07          and    A,#$7                      
    85F5  5F             clrw   X                          
    85F6  97             ld     XL,A                       
    85F7  E6 94          ld     A,($94,X)                  
    85F9  CC 86 96       jp     L_8696                     

; Mode 2 (010): the binary counter, tick >> 6 (one count per 64 frames).
mode_2:
    85FC  BE 3F          ldw    X,$3F                      
    85FE  A6 06          ld     A,#$6                      
L_8600:
    8600  54             srlw   X                          
    8601  4A             dec    A                          
    8602  26 FC          jrne   L_8600                     
    8604  01             rrwa   X                          
    8605  CC 86 96       jp     L_8696                     

; Mode 3 (011): one LED left and right, table RAM $44.
mode_3:
    8608  BE 3F          ldw    X,$3F                      
    860A  54             srlw   X                          
    860B  54             srlw   X                          
    860C  54             srlw   X                          
    860D  54             srlw   X                          
    860E  54             srlw   X                          
    860F  01             rrwa   X                          
    8610  A4 0F          and    A,#$F                      
    8612  5F             clrw   X                          
    8613  02             rlwa   X                          
    8614  E6 44          ld     A,($44,X)                  
    8616  20 7E          jra    L_8696                     

; Mode 4 (100): fill from the ends and empty, table RAM $A4.
mode_4:
    8618  BE 3F          ldw    X,$3F                      
    861A  54             srlw   X                          
    861B  54             srlw   X                          
    861C  54             srlw   X                          
    861D  54             srlw   X                          
    861E  54             srlw   X                          
    861F  9F             ld     A,XL                       
    8620  A4 07          and    A,#$7                      
    8622  5F             clrw   X                          
    8623  97             ld     XL,A                       
    8624  E6 A4          ld     A,($A4,X)                  
    8626  20 6E          jra    L_8696                     

; Mode 5 (101): the sweep, table RAM $74.
mode_5:
    8628  BE 3F          ldw    X,$3F                      
    862A  54             srlw   X                          
    862B  54             srlw   X                          
    862C  54             srlw   X                          
    862D  54             srlw   X                          
    862E  54             srlw   X                          
    862F  01             rrwa   X                          
    8630  A4 1F          and    A,#$1F                     
    8632  5F             clrw   X                          
    8633  02             rlwa   X                          
    8634  E6 74          ld     A,($74,X)                  
    8636  20 5E          jra    L_8696                     

; Mode 6 (110): Dice Roll. The roll step (RAM $B7) advances when tick is a
; multiple of 2^(6 + step/4): steps 1-7 draw a new face (never the previous one),
; 8 blanks, 9 shows the 7th face again, 10 holds it. The step is cleared only in
; mode 7, so a roll starts when the mode goes from 7 to 6 (M0 falling).
mode_6_dice:
    8638  BE 3F          ldw    X,$3F                      
    863A  B6 B7          ld     A,$B7                      
    863C  44             srl    A                          
    863D  44             srl    A                          
    863E  A0 0A          sub    A,#$A                      
    8640  40             neg    A                          
    8641  27 04          jreq   L_8647                     
L_8643:
    8643  58             slaw   X                          
    8644  4A             dec    A                          
    8645  26 FC          jrne   L_8643                     
L_8647:
    8647  A3 00 00       cpw    X,#$0                      
    864A  26 44          jrne   L_8690                     
    864C  B6 B7          ld     A,$B7                      
    864E  A1 0A          cp     A,#$A                      
    8650  24 3E          jruge  L_8690                     
    8652  3C B7          inc    $B7                        
    8654  B6 B7          ld     A,$B7                      
    8656  A1 08          cp     A,#$8                      
    8658  24 24          jruge  L_867E                     
    865A  45 B5 B6       mov    $B6,$B5                    
    865D  20 17          jra    L_8676                     
L_865F:
    865F  CD 85 62       call   random                     
    8662  BE B3          ldw    X,$B3                      
    8664  54             srlw   X                          
    8665  54             srlw   X                          
    8666  54             srlw   X                          
    8667  54             srlw   X                          
    8668  54             srlw   X                          
    8669  9F             ld     A,XL                       
    866A  A4 07          and    A,#$7                      
    866C  B7 B5          ld     $B5,A                      
    866E  A1 06          cp     A,#$6                      
    8670  27 ED          jreq   L_865F                     
    8672  A1 07          cp     A,#$7                      
    8674  27 E9          jreq   L_865F                     
L_8676:
    8676  B6 B6          ld     A,$B6                      
    8678  B1 B5          cp     A,$B5                      
    867A  27 E3          jreq   L_865F                     
    867C  B6 B7          ld     A,$B7                      
L_867E:
    867E  A1 08          cp     A,#$8                      
    8680  26 07          jrne   L_8689                     
    8682  45 B5 B6       mov    $B6,$B5                    
    8685  35 06 00 B5    mov    $B5,#$6                    
L_8689:
    8689  A1 09          cp     A,#$9                      
    868B  26 03          jrne   L_8690                     
    868D  45 B6 B5       mov    $B5,$B6                    
L_8690:
    8690  B6 B5          ld     A,$B5                      
    8692  5F             clrw   X                          
    8693  97             ld     XL,A                       
    8694  E6 AC          ld     A,($AC,X)                  
L_8696:
    8696  B7 41          ld     $41,A                      
    8698  CD 88 A1       call   show_pattern               
L_869B:
    869B  CD 85 62       call   random                     
    869E  BE 3F          ldw    X,$3F                      
    86A0  5C             incw   X                          
    86A1  BF 3F          ldw    $3F,X                      
    86A3  CC 85 B9       jp     main_loop                  

; All of port D to inputs: no LED lit.
leds_off:
    86A6  92 3F 00       clr    [$0.w]                     
    86A9  BE 00          ldw    X,$0                       
    86AB  6F 02          clr    ($2,X)                     
    86AD  6F 03          clr    ($3,X)                     
    86AF  6F 04          clr    ($4,X)                     
    86B1  81             ret                               

; b0-b7 as floating inputs, no interrupts.
setup_inputs:
    86B2  4B 00          push   #$0                        
    86B4  4B 04          push   #$4                        
    86B6  BE 14          ldw    X,$14                      
    86B8  CD 81 A8       call   GPIO_Init                  
    86BB  85             popw   X                          
    86BC  4B 00          push   #$0                        
    86BE  4B 80          push   #$80                       
