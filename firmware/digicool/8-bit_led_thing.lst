    86C2  CD 81 A8       call   GPIO_Init                  
    86C5  85             popw   X                          
    86C6  4B 00          push   #$0                        
    86C8  4B 40          push   #$40                       
    86CA  BE 10          ldw    X,$10                      
    86CC  CD 81 A8       call   GPIO_Init                  
    86CF  85             popw   X                          
    86D0  4B 00          push   #$0                        
    86D2  4B 20          push   #$20                       
    86D4  BE 0E          ldw    X,$E                       
    86D6  CD 81 A8       call   GPIO_Init                  
    86D9  85             popw   X                          
