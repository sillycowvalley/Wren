    8783  BE 2A          ldw    X,$2A                      
    8785  5C             incw   X                          
    8786  BF 2A          ldw    $2A,X                      
L_8788:
    8788  81             ret                               

; RAM $42 = M0 + 2*M1 + 4*M2, read raw (no debounce); a change from RAM $43
; zeroes tick, restarting the mode's sequence.
read_mode:
    8789  3F 42          clr    $42                        
    878B  BE 16          ldw    X,$16                      
    878D  E6 01          ld     A,($1,X)                   
    878F  A5 08          bcp    A,#$8                      
    8791  27 04          jreq   L_8797                     
    8793  72 10 00 42    bset   $42,#0                     
L_8797:
    8797  BE 18          ldw    X,$18                      
    8799  E6 01          ld     A,($1,X)                   
    879B  A5 04          bcp    A,#$4                      
    879D  27 04          jreq   L_87A3                     
    879F  72 12 00 42    bset   $42,#1                     
L_87A3:
    87A3  BE 1A          ldw    X,$1A                      
    87A5  E6 01          ld     A,($1,X)                   
    87A7  A5 02          bcp    A,#$2                      
    87A9  27 04          jreq   L_87AF                     
    87AB  72 14 00 42    bset   $42,#2                     
L_87AF:
    87AF  B6 42          ld     A,$42                      
    87B1  B1 43          cp     A,$43                      
    87B3  27 06          jreq   L_87BB                     
    87B5  45 42 43       mov    $43,$42                    
    87B8  5F             clrw   X                          
    87B9  BF 3F          ldw    $3F,X                      
L_87BB:
    87BB  81             ret                               

; Light one LED: its anode line high and its cathode line low, the other two
; lines left as inputs (charlieplexing).
light_led:
    87BC  89             pushw  X                          
    87BD  9E             ld     A,XH                       
    87BE  92 C7 00       ld     [$0.w],A                   
    87C1  9F             ld     A,XL                       
    87C2  1A 01          or     A,($1,SP)                  
    87C4  BE 00          ldw    X,$0                       
    87C6  E7 02          ld     ($2,X),A                   
    87C8  7B 01          ld     A,($1,SP)                  
    87CA  1A 02          or     A,($2,SP)                  
    87CC  E7 03          ld     ($3,X),A                   
    87CE  7B 01          ld     A,($1,SP)                  
    87D0  1A 02          or     A,($2,SP)                  
    87D2  E7 04          ld     ($4,X),A                   
    87D4  85             popw   X                          
    87D5  81             ret                               

