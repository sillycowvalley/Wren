; Disassembly of Digicool Things' 8-bit_led_thing.s19: the 8-bit LED Thing's factory firmware.
; Digicool's work, here with Greg's permission; not covered by Wren's MIT licence.
;
; Compiled C (an ST Visual Develop "Release" build, Cosmic's .sm8 output) with ST's Standard
; Peripheral Library linked in. Disassembled with ucsim 0.6.4 (sstm8) by following the code
; from the interrupt vectors through every call, jump and branch; code nothing reaches is
; decoded too and marked "never called"; tables are shown as bytes. Register names are from
; firmware/include/stm8s003.inc. The comments come from reading the code and running the
; image in Wren's emulator; docs/LedThing.md describes the behaviour.

; ---- Interrupt vectors ----
    8000  82 00 81 50    int    reset                   ; reset
    8004  82 00 85 24    int    vector_01               ; TRAP
    8008  82 00 85 25    int    vector_02               ; IRQ 0
    800C  82 00 85 26    int    vector_03               ; IRQ 1
    8010  82 00 85 27    int    vector_04               ; IRQ 2
    8014  82 00 85 28    int    vector_05               ; IRQ 3
    8018  82 00 85 29    int    vector_06               ; IRQ 4
    801C  82 00 85 2A    int    vector_07               ; IRQ 5
    8020  82 00 85 2B    int    vector_08               ; IRQ 6
    8024  82 00 85 2C    int    vector_09               ; IRQ 7
    8028  82 00 85 23    int    unused_irq              ; IRQ 8
    802C  82 00 85 23    int    unused_irq              ; IRQ 9
    8030  82 00 85 2D    int    vector_12               ; IRQ 10
    8034  82 00 85 2E    int    vector_13               ; IRQ 11
    8038  82 00 85 2F    int    vector_14               ; IRQ 12
    803C  82 00 85 30    int    vector_15               ; IRQ 13
    8040  82 00 85 31    int    vector_16               ; IRQ 14
    8044  82 00 85 23    int    unused_irq              ; IRQ 15
    8048  82 00 85 23    int    unused_irq              ; IRQ 16
    804C  82 00 85 32    int    vector_19               ; IRQ 17
    8050  82 00 85 33    int    vector_20               ; IRQ 18
    8054  82 00 85 34    int    vector_21               ; IRQ 19
    8058  82 00 85 23    int    unused_irq              ; IRQ 20
    805C  82 00 85 23    int    unused_irq              ; IRQ 21
    8060  82 00 85 35    int    vector_24               ; IRQ 22
    8064  82 00 85 36    int    vector_25               ; IRQ 23
    8068  82 00 85 37    int    vector_26               ; IRQ 24
    806C  82 00 85 23    int    unused_irq              ; IRQ 25
    8070  82 00 85 23    int    unused_irq              ; IRQ 26
    8074  82 00 85 23    int    unused_irq              ; IRQ 27
    8078  82 00 85 23    int    unused_irq              ; IRQ 28
    807C  82 00 85 23    int    unused_irq              ; IRQ 29

; ST's clock library: the prescaler tables (never used)
    8080  .db $01, $02, $04, $08, $01, $02, $04, $08, $0A, $10, $14, $28

; a float constant for the unused delay_ms
    808C  .db $3E, $80, $00, $00

; Cosmic's start-up descriptor: copy flash $8098-$814F to RAM $00-$B7
    8090  .db $80, $98, $62, $00, $00, $81, $50, $00

; RAM $00-$05: port D's address, then the masks of PD3, PD4, PD5, PD6 (the LED lines)
    8098  .db $50, $0F, $08, $10, $20, $40

; RAM $06-$1B: the input pins' port addresses: b7, b6 (port B), b5-b1 (port C), b0 (port D), M0-M2 (port A)
    809E  .db $50, $05, $50, $05, $50, $0A, $50, $0A, $50, $0A, $50, $0A, $50, $0A, $50, $0F
    80AE  .db $50, $00, $50, $00, $50, $00

; RAM $1C-$43: variables, zero at start: the poll counts per input, tick ($3F), pattern ($41), mode ($42), last mode ($43)
    80B4  .db $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
    80C4  .db $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00
    80D4  .db $00, $00, $00, $00, $00, $00, $00, $00

; RAM $44: mode 3's sequence, a single LED left and right, each end held two steps
    80DC  .db $01, $02, $04, $08, $10, $20, $40, $80, $80, $40, $20, $10, $08, $04, $02, $01

; RAM $54: a fill and empty (never used)
    80EC  .db $01, $03, $07, $0F, $1F, $3F, $7F, $FF, $FE, $FC, $F8, $F0, $E0, $C0, $80, $00

; RAM $64: the four mirrored LED pairs counting in binary (never used)
    80FC  .db $81, $42, $C3, $24, $A5, $66, $E7, $18, $99, $5A, $DB, $3C, $BD, $7E, $FF, $00

; RAM $74: mode 5's sequence, fill from b0, empty, fill from b7, empty
    810C  .db $01, $03, $07, $0F, $1F, $3F, $7F, $FF, $FE, $FC, $F8, $F0, $E0, $C0, $80, $00
    811C  .db $80, $C0, $E0, $F0, $F8, $FC, $FE, $FF, $7F, $3F, $1F, $0F, $07, $03, $01, $00

; RAM $94: mode 1's sequence, two LEDs moving in and out
    812C  .db $81, $42, $24, $18, $24, $42, $81, $00

; RAM $9C: mode 0's sequence, the curtain closing and opening
    8134  .db $81, $C3, $E7, $FF, $E7, $C3, $81, $00

; RAM $A4: mode 4's sequence, fill from the ends, then empty from the ends
    813C  .db $81, $C3, $E7, $FF, $7E, $3C, $18, $00

; RAM $AC: the die's faces, 1 to 6 pips, then blank (RAM $B3-$B4 random state, $B5 face, $B6 previous face, $B7 roll step follow, zero)
    8144  .db $10, $18, $34, $3C, $7A, $7E, $00, $80, $00, $00, $00, $00

; Cosmic's C start-up: stack at $03FF, copy the initialised data to RAM, clear
; RAM $B8-$C1, call main, then loop forever.
reset:
    8150  AE 03 FF       ldw    X,#RAM_END                 
    8153  94             ldw    SP,X                       
    8154  90 CE 80 90    ldw    Y,$8090                    
    8158  AE 80 92       ldw    X,#$8092                   
L_815B:
    815B  F6             ld     A,(X)                      
    815C  27 25          jreq   L_8183                     
    815E  A5 60          bcp    A,#$60                     
    8160  27 17          jreq   L_8179                     
    8162  BF BC          ldw    $BC,X                      
    8164  EE 03          ldw    X,($3,X)                   
    8166  BF BF          ldw    $BF,X                      
    8168  BE BC          ldw    X,$BC                      
    816A  EE 01          ldw    X,($1,X)                   
L_816C:
    816C  90 F6          ld     A,(Y)                      
    816E  F7             ld     (X),A                      
    816F  5C             incw   X                          
    8170  90 5C          incw   Y                          
    8172  90 B3 BF       cpw    Y,$BF                      
    8175  26 F5          jrne   L_816C                     
    8177  BE BC          ldw    X,$BC                      
L_8179:
    8179  90 93          ldw    Y,X                        
    817B  90 EE 03       ldw    Y,($3,Y)                   
    817E  1C 00 05       addw   X,#$5                      
    8181  20 D8          jra    L_815B                     
L_8183:
    8183  AE 00 B8       ldw    X,#$B8                     
    8186  20 02          jra    L_818A                     
L_8188:
    8188  F7             ld     (X),A                      
    8189  5C             incw   X                          
L_818A:
    818A  A3 00 C2       cpw    X,#$C2                     
    818D  26 F9          jrne   L_8188                     
    818F  AE 01 00       ldw    X,#$100                    
    8192  20 02          jra    L_8196                     
L_8194:
    8194  F7             ld     (X),A                      
    8195  5C             incw   X                          
L_8196:
    8196  A3 01 00       cpw    X,#$100                    
    8199  26 F9          jrne   L_8194                     
    819B  CD 85 8E       call   main                       
L_819E:
    819E  20 FE          jra    L_819E                     

; ST library: a port's ODR, DDR, CR1 and CR2 to 0.
GPIO_DeInit:
    81A0  7F             clr    (X)                        
    81A1  6F 02          clr    ($2,X)                     
    81A3  6F 03          clr    ($3,X)                     
    81A5  6F 04          clr    ($4,X)                     
    81A7  81             ret                               

; ST library: set the pins in a mask (on the stack) to a mode (floating input,
; pull-up input, push-pull output ...) on the port at X.
GPIO_Init:
