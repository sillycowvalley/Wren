    86E0  CD 81 A8       call   GPIO_Init                  
    86E3  85             popw   X                          
    86E4  4B 00          push   #$0                        
    86E6  4B 08          push   #$8                        
    86E8  BE 0A          ldw    X,$A                       
    86EA  CD 81 A8       call   GPIO_Init                  
    86ED  85             popw   X                          
    86EE  4B 00          push   #$0                        
    86F0  4B 10          push   #$10                       
    86F2  BE 08          ldw    X,$8                       
    86F4  CD 81 A8       call   GPIO_Init                  
    86F7  85             popw   X                          
    86F8  4B 00          push   #$0                        
    86FA  4B 20          push   #$20                       
    86FC  BE 06          ldw    X,$6                       
    86FE  CD 81 A8       call   GPIO_Init                  
    8701  85             popw   X                          
    8702  81             ret                               

; M0 (PA3), M1 (PA2), M2 (PA1) as pull-up inputs.
setup_mode_pins:
    8703  4B 40          push   #$40                       
    8705  4B 08          push   #$8                        
    8707  BE 16          ldw    X,$16                      
    8709  CD 81 A8       call   GPIO_Init                  
    870C  85             popw   X                          
    870D  4B 40          push   #$40                       
    870F  4B 04          push   #$4                        
    8711  BE 18          ldw    X,$18                      
    8713  CD 81 A8       call   GPIO_Init                  
    8716  85             popw   X                          
    8717  4B 40          push   #$40                       
    8719  4B 02          push   #$2                        
    871B  BE 1A          ldw    X,$1A                      
    871D  CD 81 A8       call   GPIO_Init                  
    8720  85             popw   X                          
    8721  81             ret                               

; Read the eight b inputs once, adding 1 to each one's count when it is high.
poll_inputs:
    8722  BE 14          ldw    X,$14                      
    8724  E6 01          ld     A,($1,X)                   
    8726  A5 04          bcp    A,#$4                      
    8728  27 05          jreq   L_872F                     
    872A  BE 1C          ldw    X,$1C                      
    872C  5C             incw   X                          
    872D  BF 1C          ldw    $1C,X                      
L_872F:
    872F  BE 12          ldw    X,$12                      
    8731  E6 01          ld     A,($1,X)                   
