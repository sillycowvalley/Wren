    875A  27 05          jreq   L_8761                     
    875C  BE 24          ldw    X,$24                      
    875E  5C             incw   X                          
    875F  BF 24          ldw    $24,X                      
L_8761:
    8761  BE 0A          ldw    X,$A                       
    8763  E6 01          ld     A,($1,X)                   
    8765  A5 08          bcp    A,#$8                      
    8767  27 05          jreq   L_876E                     
    8769  BE 26          ldw    X,$26                      
    876B  5C             incw   X                          
    876C  BF 26          ldw    $26,X                      
