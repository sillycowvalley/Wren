    8412  A4 18          and    A,#$18                     
    8414  20 0C          jra    L_8422                     
L_8416:
    8416  C6 50 C6       ld     A,CLK_CKDIVR               
    8419  A4 F8          and    A,#$F8                     
    841B  C7 50 C6       ld     CLK_CKDIVR,A               
    841E  7B 01          ld     A,($1,SP)                  
    8420  A4 07          and    A,#$7                      
L_8422:
    8422  CA 50 C6       or     A,CLK_CKDIVR               
    8425  C7 50 C6       ld     CLK_CKDIVR,A               
    8428  84             pop    A                          
    8429  81             ret                               

