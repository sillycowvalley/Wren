; Cosmic's default interrupt handlers: one IRET for each vector (here and below).
; No interrupt is ever enabled.
unused_irq:
    8523  80             iret                              
vector_01:
    8524  80             iret                              
vector_02:
    8525  80             iret                              
vector_03:
    8526  80             iret                              
