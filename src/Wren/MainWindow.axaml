<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Wren"
        x:Class="Wren.MainWindow"
        Title="Wren"
        Width="1000" Height="640" MinWidth="760" MinHeight="520">

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="ToggleButton.bit">
      <Setter Property="Width" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="OpenButton" Content="Open…" Click="OnOpen" ToolTip.Tip="Open an assembly source (.asm) or an image (.s19, .hex)" />
        <Button Name="ReloadButton" Content="Reload" Click="OnReload" ToolTip.Tip="Assemble and load again (also happens when the file is saved)" />
        <Border Width="12" />
        <Button Name="RunButton" Content="Run" Click="OnRun" MinWidth="64" />
        <Button Name="StepButton" Content="Step" Click="OnStep" ToolTip.Tip="Run one instruction" />
        <Button Name="ResetButton" Content="Reset" Click="OnReset" ToolTip.Tip="Pull NRST low: the chip restarts, RAM and the OLED keep their contents" />
        <Button Name="PowerButton" Content="Power cycle" Click="OnPowerCycle" ToolTip.Tip="Power off and on: RAM and the OLED are cleared" />
        <Border Width="12" />
        <ComboBox Name="BoardBox" SelectionChanged="OnBoardChanged" MinWidth="250">
          <ComboBoxItem>OLED Thing (STM8S003F3)</ComboBoxItem>
          <ComboBoxItem>Development board (STM8S103F3)</ComboBoxItem>
        </ComboBox>
        <TextBlock Name="FileText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Name="StatusText" Opacity="0.8" />
    </Border>

    <!-- Right: CPU and messages -->
    <Border DockPanel.Dock="Right" Width="300" Padding="12" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Classes="heading" Text="CPU" Margin="0,0,0,6" />
          <TextBlock Name="RegistersText" FontFamily="Consolas, Menlo, monospace" />
          <TextBlock Classes="heading" Text="Flash and EEPROM wear" />
          <TextBlock Name="WearText" FontFamily="Consolas, Menlo, monospace" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Classes="heading" Text="Messages" />
        </StackPanel>
        <ListBox Name="MessagesList" FontSize="12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Centre: the board -->
    <ScrollViewer>
      <StackPanel Margin="16" Spacing="4">
        <Border CornerRadius="6" Padding="10" Background="#1B2A4A" HorizontalAlignment="Left">
          <local:OledView Name="Oled" Width="512" Height="256" />
        </Border>

        <TextBlock Classes="heading" Text="Inputs b7 – b0" />
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ToggleButton Classes="bit" Name="B7" Content="b7" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B6" Content="b6" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B5" Content="b5" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B4" Content="b4" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B3" Content="b3" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B2" Content="b2" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B1" Content="b1" Click="OnBitClicked" />
          <ToggleButton Classes="bit" Name="B0" Content="b0" Click="OnBitClicked" />
          <TextBox Name="HexBox" Width="64" Margin="12,0,0,0" FontFamily="Consolas, Menlo, monospace"
                   Watermark="hex" KeyUp="OnHexKeyUp" ToolTip.Tip="Type a value in hex and press Enter" />
        </StackPanel>

        <TextBlock Classes="heading" Text="Mode pins (checked = pulled to GND)" />
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox Name="HexPin" Content="HEX (PA1)" Click="OnModePinClicked" />
          <CheckBox Name="BarPin" Content="BAR (PA2)" Click="OnModePinClicked" />
          <CheckBox Name="InvPin" Content="INV (PA3)" Click="OnModePinClicked" />
        </StackPanel>

        <TextBlock Classes="heading" Text="Spare pins (held low while pressed)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Name="Pd2Button" Content="PD2" Width="64" HorizontalContentAlignment="Center" />
          <Button Name="Pd3Button" Content="PD3" Width="64" HorizontalContentAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
