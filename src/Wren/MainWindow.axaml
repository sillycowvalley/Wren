<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Wren"
        xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
        x:Class="Wren.MainWindow"
        x:DataType="local:MainWindow"
        Title="Wren"
        Icon="/Assets/wren.ico"
        Width="1400" Height="780" MinWidth="1100" MinHeight="600">

  <Window.Styles>
    <Style Selector="ToggleButton.bit">
      <Setter Property="Width" Value="42" />
      <Setter Property="Padding" Value="0,3" />
    </Style>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Menlo, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="#5A5A5A" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" Click="OnNew" />
        <MenuItem Header="_Open…" InputGesture="Ctrl+O" Click="OnOpen" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSave" />
        <MenuItem Header="Save _As…" InputGesture="Ctrl+Shift+S" Click="OnSaveAs" />
        <Separator />
        <MenuItem Header="_Reload" InputGesture="Ctrl+R" Click="OnReload" ToolTip.Tip="Back to the program as saved" />
        <Separator />
        <MenuItem Header="E_xit" InputGesture="Alt+F4" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndo" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedo" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Click="OnCut" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Click="OnCopy" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Click="OnPaste" />
        <MenuItem Header="De_lete" InputGesture="Delete" Click="OnDelete" />
        <Separator />
        <MenuItem Header="_Find…" InputGesture="Ctrl+F" Click="OnFind" />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="OnSelectAll" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Build" InputGesture="F7" Click="OnBuild"
                  ToolTip.Tip="Compiles the program and lists any errors in Messages; runs nothing" />
      </MenuItem>
      <MenuItem Header="_Debug">
        <MenuItem Name="StartMenu" Header="_Start Debugging" InputGesture="F5" Click="OnStartDebugging" />
        <MenuItem Name="StartFreeMenu" Header="Start _Without Debugging" InputGesture="Ctrl+F5" Click="OnStartWithoutDebugging" />
        <MenuItem Name="StopMenu" Header="Stop D_ebugging" InputGesture="Shift+F5" Click="OnStop" />
        <MenuItem Name="RestartMenu" Header="_Restart" InputGesture="Ctrl+Shift+F5" Click="OnRestart" />
        <MenuItem Name="BreakMenu" Header="Break _All" InputGesture="Ctrl+Alt+Pause" Click="OnBreakAll" />
        <Separator />
        <MenuItem Name="StepIntoMenu" Header="Step _Into" InputGesture="F11" Click="OnStepInto" />
        <MenuItem Name="StepOverMenu" Header="Step _Over" InputGesture="F10" Click="OnStepOver" />
        <MenuItem Name="StepOutMenu" Header="Step Ou_t" InputGesture="Shift+F11" Click="OnStepOut" />
        <MenuItem Name="RunToCursorMenu" Header="Run To _Cursor" InputGesture="Ctrl+F10" Click="OnRunToCursor" />
        <MenuItem Header="Toggle _Breakpoint" InputGesture="F9" Click="OnToggleBreakpoint" />
        <Separator />
        <MenuItem Header="Tar_get">
          <MenuItem Name="EmulatorTargetMenu" Header="_Emulator" ToggleType="Radio" GroupName="target" IsChecked="True" Click="OnTargetChanged" />
          <MenuItem Name="ThingTargetMenu" Header="_Thing on the programmer" ToggleType="Radio" GroupName="target" Click="OnTargetChanged"
                    ToolTip.Tip="Ctrl+F5 uploads the program to a real Thing (only if it changed) and runs it" />
        </MenuItem>
        <Separator />
        <MenuItem Name="ResetMenu" Header="Reset the emulated Thing" Click="OnReset" />
        <MenuItem Name="PowerMenu" Header="_Power cycle the emulated Thing" Click="OnPowerCycle" />
      </MenuItem>
      <MenuItem Header="_Board">
        <MenuItem Name="ThingMenu" Header="_OLED Thing (STM8S003F3)" ToggleType="Radio" GroupName="board" IsChecked="True" Click="OnBoardChanged" />
        <MenuItem Name="DevBoardMenu" Header="_Development board (STM8S103F3)" ToggleType="Radio" GroupName="board" Click="OnBoardChanged" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Firmware…" Click="OnOpenLink"
                  ToolTip.Tip="Sets a real Thing up: installs Wren's kernel, restores the factory firmware, and checks the Thing" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Wren BASIC _quick reference" Click="OnQuickReference" />
        <Separator />
        <MenuItem Header="_About Wren" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Classes="statusbar">
      <TextBlock Name="StatusText" />
    </Border>

    <!-- Left: the program, editable; middle: the board; right: what the program is doing.
         Drag the splitter to share the width between the program and the right-hand column. -->
    <Grid Name="RightGrid" Margin="10,8,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="260" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="320" MinWidth="220" MaxWidth="700" />
      </Grid.ColumnDefinitions>
      <HeaderedContentControl Grid.Column="0" Classes="group" Header="Program (F9, or click left of a line number, for a breakpoint)">
        <Border Classes="view">
          <edit:TextEditor Name="Editor" ShowLineNumbers="True"
                           FontFamily="Consolas, Cascadia Mono, Menlo, monospace" FontSize="13"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           LineNumbersForeground="#2B91AF" Background="White" />
        </Border>
      </HeaderedContentControl>

      <!-- Middle: the board -->
      <Border Grid.Column="1" Padding="10,0">
        <DockPanel>
          <TextBlock Name="ThingNote" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap" MaxWidth="460"
                     Margin="0,0,0,6" FontWeight="SemiBold"
                     Text="The program runs on the Thing: its own OLED and pins show what it does. This is the emulator's board." />
        <ScrollViewer>
          <StackPanel Name="BoardPanel" Spacing="2">
            <HeaderedContentControl Classes="group" Header="OLED">
              <Border Background="#1B2A4A" Padding="8" HorizontalAlignment="Left" BorderBrush="#0E1626" BorderThickness="1">
                <local:OledView Name="Oled" Width="448" Height="224" />
              </Border>
            </HeaderedContentControl>

            <HeaderedContentControl Classes="group" Header="Inputs b7 – b0">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <ToggleButton Classes="bit" Name="B7" Content="b7" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B6" Content="b6" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B5" Content="b5" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B4" Content="b4" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B3" Content="b3" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B2" Content="b2" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B1" Content="b1" Click="OnBitClicked" />
                <ToggleButton Classes="bit" Name="B0" Content="b0" Click="OnBitClicked" />
                <TextBox Name="HexBox" Width="48" Margin="8,0,0,0" Watermark="hex" KeyUp="OnHexKeyUp"
                         VerticalContentAlignment="Center" ToolTip.Tip="Type a value in hex and press Enter" />
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Classes="group" Header="Mode pins">
              <StackPanel>
                <TextBlock Classes="note" Text="Checked = pulled to GND." />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox Name="HexPin" Content="HEX (PA1)" Click="OnPinClicked" />
                  <CheckBox Name="BarPin" Content="BAR (PA2)" Click="OnPinClicked" />
                  <CheckBox Name="InvPin" Content="INV (PA3)" Click="OnPinClicked" />
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Classes="group" Header="Spare pins">
              <StackPanel>
                <TextBlock Classes="note" Text="Checked = held low; Pulse pulls the pin low while it is pressed." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Name="Pd2Pin" Content="PD2" Click="OnPinClicked" VerticalAlignment="Center" />
                  <Button Name="Pd2Button" Content="Pulse" />
                  <Border Width="16" />
                  <CheckBox Name="Pd3Pin" Content="PD3" Click="OnPinClicked" VerticalAlignment="Center" />
                  <Button Name="Pd3Button" Content="Pulse" />
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Classes="group" Header="Analog inputs (for ANALOG)">
              <Grid ColumnDefinitions="Auto,*,48" RowDefinitions="Auto,Auto" Width="440" HorizontalAlignment="Left">
                <CheckBox Name="Pd2Analog" Grid.Row="0" Content="PD2" Click="OnPinClicked"
                          ToolTip.Tip="Feed PD2 an analog level instead of its digital one" />
                <Slider Name="Pd2Level" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1023" Margin="12,0"
                        ValueChanged="OnAnalogLevelChanged" />
                <TextBlock Name="Pd2Text" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" />
                <CheckBox Name="Pd3Analog" Grid.Row="1" Content="PD3" Click="OnPinClicked"
                          ToolTip.Tip="Feed PD3 an analog level instead of its digital one" />
                <Slider Name="Pd3Level" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1023" Margin="12,0"
                        ValueChanged="OnAnalogLevelChanged" />
                <TextBlock Name="Pd3Text" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" />
              </Grid>
            </HeaderedContentControl>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Name="Splitter" Grid.Column="2" ResizeDirection="Columns" Background="Transparent"
                    ToolTip.Tip="Drag to resize" />

      <DockPanel Grid.Column="3">
        <StackPanel DockPanel.Dock="Top">
          <HeaderedContentControl Classes="group" Header="Now">
            <TextBlock Name="NowText" TextWrapping="Wrap" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="group" Header="Variables">
            <TextBlock Name="VariablesText" Classes="code" TextWrapping="Wrap" />
          </HeaderedContentControl>
          <HeaderedContentControl Classes="group" Header="Program and flash">
            <TextBlock Name="StoreText" TextWrapping="Wrap" />
          </HeaderedContentControl>
        </StackPanel>
        <HeaderedContentControl Classes="group" Header="Messages">
          <ListBox Name="MessagesList" SelectionMode="Multiple" KeyDown="OnMessagesKeyDown">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="_Copy" InputGesture="Ctrl+C" Click="OnCopyMessages" />
                <MenuItem Header="Copy _All" Click="OnCopyAllMessages" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </HeaderedContentControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
