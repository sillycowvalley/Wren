<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Wren.LinkWindow"
        Title="Wren — Firmware"
        Width="720" Height="560" MinWidth="560" MinHeight="420">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock Text="Wiring:" VerticalAlignment="Center" />
        <Button Classes="link" Click="OnPicoWiring" ToolTip.Tip="How to wire a Pico (or RP2040 Plus) to the Thing, and which firmware to put on it">
          <TextBlock Text="Pico programmer" />
        </Button>
        <Button Classes="link" Click="OnStLinkWiring" ToolTip.Tip="How to wire an ST-LINK V2 to the Thing">
          <TextBlock Text="ST-LINK V2 programmer" />
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ComboBox Name="DeviceBox" MinWidth="260" />
        <Button Name="FindButton" Content="↻" Click="OnFind" Padding="6,3" ToolTip.Tip="Refresh the list: look again for ST-LINKs on USB and Picos on serial ports" />
        <Button Name="ConnectButton" Content="Connect" Click="OnConnect" ToolTip.Tip="Open the programmer, enter SWIM and read the Thing" />
        <Button Name="DisconnectButton" Content="Disconnect" Click="OnDisconnect"
                ToolTip.Tip="Lets go of the Thing, which then runs (connected, its program is stopped)" />
      </StackPanel>
      <HeaderedContentControl Classes="group" Header="Write FLASH">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Name="KernelButton" Content="Install kernel" Click="OnInstallKernel"
                  ToolTip.Tip="Writes only the kernel blocks that differ; each written block costs one of the Thing's ~100 flash writes" />
          <Button Name="ImageButton" Content="Write image…" Click="OnWriteImage"
                  ToolTip.Tip="Writes a firmware file (.s19 or .hex, such as Digicool's factory firmware in firmware\digicool) like Install kernel: only blocks that differ, then checked. Removes read-out protection first if it is on (which erases the chip), clears the EEPROM and leaves protection off." />
          <TextBlock Text="Warning: FLASH can only be written ~100 times." VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#A0522D" />
        </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Classes="group" Header="Diagnostics">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Name="WearButton" Content="Wear report…" Click="OnWearReport"
                  ToolTip.Tip="Shows the writes the Thing has recorded for each of its 54 program-store blocks; reads only" />
          <Button Name="DebugChecksButton" Content="Debug module checks" Click="OnDebugChecks"
                  ToolTip.Tip="Checks the chip's debug module for debugging on the Thing: a breakpoint on reading the program, reading RAM while it runs, stopping it, and freezing its 1 ms timer. Writes no flash or EEPROM." />
        </StackPanel>
      </HeaderedContentControl>
      <TextBlock Name="StatusText" TextWrapping="Wrap" />
    </StackPanel>
    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Close" Click="OnClose" IsCancel="True"
            MinWidth="75" Margin="0,8,0,0" ToolTip.Tip="Closes this window; a connected Thing is let go and runs" />
    <HeaderedContentControl Classes="group" Header="Log" Margin="0,8,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,6,0,0">
          <Button Content="Copy" Click="OnCopyLog" ToolTip.Tip="Copies the whole log to the clipboard" />
          <Button Content="Clear" Click="OnClearLog" ToolTip.Tip="Empties the log" />
        </StackPanel>
        <TextBox Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas, Cascadia Mono, Menlo, monospace" FontSize="12" />
      </DockPanel>
    </HeaderedContentControl>
  </DockPanel>
</Window>
